#include <iostream>
#include <vector>

using namespace std;


vector<vector<int>> complementoGrafo(const vector<vector<int>>& grafo) {
    int n = grafo.size();
    vector<vector<int>> complemento(n, vector<int>(n, 0));

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            // Evitar bucles (i == j)
            if (i != j) {
                complemento[i][j] = (grafo[i][j] == 0) ? 1 : 0;
            }
        }
    }

    return complemento;
}


void mostrarMatriz(const vector<vector<int>>& matriz) {
    for (const auto& fila : matriz) {
        for (int val : fila) {
            cout << val << " ";
        }
        cout << endl;
    }
}

int main() {
    int n;
    cout << "Ingrese el numero de vertices del grafo: ";
    cin >> n;

    vector<vector<int>> grafo(n, vector<int>(n));
    cout << "Ingrese la matriz de adyacencia del grafo (" << n << "x" << n << "):\n";

    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> grafo[i][j];
        }
    }

 
    vector<vector<int>> comp = complementoGrafo(grafo);

    
    cout << "\nMatriz de adyacencia del grafo complemento:\n";
    mostrarMatriz(comp);

    return 0;
}
